RewriteEngine On

# Maintenance landing page — only these assets are served directly
RewriteRule ^(maintenance\.css|maintenance\.js|favicon\.ico)$ - [L]
RewriteRule ^assets/HRM\.png$ - [L]

# Everything else routes to the maintenance homepage
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteRule ^ / [R=302,L]
